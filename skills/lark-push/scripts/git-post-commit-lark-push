#!/usr/bin/env bash
# Optional git post-commit hook: notify the configured Lark chat after a local commit.
#
# Install (prefer symlink so the hook always runs the latest helper):
#   ln -sf ~/.agents/skills/lark-push/scripts/git-post-commit-lark-push \
#     .git/hooks/post-commit
#
# Note: SCRIPT_DIR resolves to .git/hooks (symlink dir, not the skill package);
# the helper is found via the known install paths in resolve_lark_push below.
#
# Disable without removing the hook:
#   export LARK_PUSH_GIT_HOOK=0
#
# This is fire-and-forget: it never blocks the commit on network/auth failures.
set -euo pipefail

if [[ "${LARK_PUSH_GIT_HOOK:-1}" == "0" || "${LARK_PUSH_GIT_HOOK:-1}" == "false" ]]; then
  exit 0
fi

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"

resolve_lark_push() {
  local candidate
  for candidate in \
    "${SCRIPT_DIR}/lark-push" \
    "${HOME}/.agents/skills/lark-push/scripts/lark-push" \
    "${HOME}/.claude/skills/lark-push/scripts/lark-push" \
    "${HOME}/.codex/skills/lark-push/scripts/lark-push" \
    "${HOME}/.grok/skills/lark-push/scripts/lark-push"
  do
    if [[ -x "$candidate" ]]; then
      printf '%s' "$candidate"
      return 0
    fi
  done
  return 1
}

LARK_PUSH_BIN="$(resolve_lark_push || true)"
if [[ -z "${LARK_PUSH_BIN}" ]]; then
  echo "lark-push: post-commit hook could not find lark-push script (non-fatal)" >&2
  exit 0
fi

COMMIT="$(git log -1 --pretty=format:'%h %s')"
AUTHOR="$(git log -1 --pretty=format:'%an')"
BRANCH="$(git branch --show-current 2>/dev/null || true)"
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
REPO_NAME="$(basename "$REPO_ROOT")"

BODY="Repo: ${REPO_NAME}
Branch: ${BRANCH:-unknown}
Commit: ${COMMIT}
Author: ${AUTHOR}"

# Fire-and-forget: never block the commit, never show noise on success.
(
  set +e
  if ! "${LARK_PUSH_BIN}" \
    --kind code \
    --title "Local commit" \
    --body "$BODY" >/dev/null 2>&1; then
    echo "lark-push: failed to send commit notification (non-fatal)" >&2
  fi
) &
disown 2>/dev/null || true
