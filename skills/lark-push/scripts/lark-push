#!/usr/bin/env bash
set -euo pipefail

# Resolve skill root even when this script is reached via agent symlink.
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
SKILL_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd -P)"
SKILL_NAME="$(basename -- "$SKILL_ROOT")"
SKILLS_PARENT="$(dirname -- "$SKILL_ROOT")"

# Durable config lives next to the skill package, not inside it.
# skills CLI reinstall/update wipes the skill directory itself, but keeps siblings.
#   symlink mode: ~/.agents/skills/lark-push  +  ~/.agents/skills/.skill-data/lark-push/config.env
#   copy mode:    ~/.claude/skills/lark-push  +  ~/.claude/skills/.skill-data/lark-push/config.env
DURABLE_CONFIG_DIR="${SKILLS_PARENT}/.skill-data/${SKILL_NAME}"
DURABLE_CONFIG_FILE="${DURABLE_CONFIG_DIR}/config.env"

# Shared fallback (useful when install mode is copy and agents each have a private tree)
GLOBAL_SHARED_CONFIG_FILE="${HOME}/.agents/skills/.skill-data/${SKILL_NAME}/config.env"

# Optional in-package override (convenient, but wiped by `npx skills update`)
LOCAL_CONFIG_FILE="${SKILL_ROOT}/config.local.env"

# Legacy XDG path (still supported)
XDG_CONFIG_FILE="${HOME}/.config/lark-push/config.env"

EXAMPLE_CONFIG_FILE="${SKILL_ROOT}/config.example.env"
SKILL_MD_FILE="${SKILL_ROOT}/SKILL.md"

# lark-cli hard limit
IDEMPOTENCY_KEY_MAX=50
# Soft warn when card/body payload may approach OS ARG_MAX
PAYLOAD_WARN_BYTES=100000

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

# Require a non-empty option value. Values may start with "-" (markdown lists).
# Usage: require_val --opt "${2-}" && val="$2"
require_val() {
  local opt="$1"
  if [[ $# -lt 2 ]]; then
    echo "Missing value for $opt" >&2
    exit 2
  fi
  local val="$2"
  if [[ -z "$val" ]]; then
    echo "Empty value for $opt" >&2
    exit 2
  fi
}

skill_version() {
  local v=""
  if [[ -f "$SKILL_MD_FILE" ]]; then
    v="$(sed -nE 's/^[[:space:]]*version:[[:space:]]*"([^"]+)".*/\1/p' "$SKILL_MD_FILE" | head -n1)"
  fi
  if [[ -z "$v" ]]; then
    v="0.0.0"
  fi
  printf '%s' "$v"
}

load_env_file() {
  local file="$1"
  [[ -f "$file" ]] || return 0
  local was_a=0
  [[ $- == *a* ]] && was_a=1
  set -a
  # shellcheck disable=SC1090
  source "$file"
  if (( ! was_a )); then
    set +a
  fi
}

# Least-specific → most-specific. Later files override earlier ones.
load_all_configs() {
  load_env_file "$XDG_CONFIG_FILE"
  load_env_file "$GLOBAL_SHARED_CONFIG_FILE"
  if [[ "$DURABLE_CONFIG_FILE" != "$GLOBAL_SHARED_CONFIG_FILE" ]]; then
    load_env_file "$DURABLE_CONFIG_FILE"
  fi
  load_env_file "$LOCAL_CONFIG_FILE"
  if [[ -n "${LARK_PUSH_CONFIG:-}" ]]; then
    load_env_file "$LARK_PUSH_CONFIG"
  fi
}

print_config_paths() {
  cat <<EOF
Skill root:           ${SKILL_ROOT}
Version:              $(skill_version)
Durable config:       ${DURABLE_CONFIG_FILE}$([[ -f "$DURABLE_CONFIG_FILE" ]] && echo "  [exists]" || echo "  [missing]")
Global shared config: ${GLOBAL_SHARED_CONFIG_FILE}$([[ -f "$GLOBAL_SHARED_CONFIG_FILE" ]] && echo "  [exists]" || echo "  [missing]")
Local (in skill):     ${LOCAL_CONFIG_FILE}$([[ -f "$LOCAL_CONFIG_FILE" ]] && echo "  [exists · wiped on skills update]" || echo "  [missing]")
XDG legacy:           ${XDG_CONFIG_FILE}$([[ -f "$XDG_CONFIG_FILE" ]] && echo "  [exists]" || echo "  [missing]")
Explicit override:    ${LARK_PUSH_CONFIG:-"(unset)"}
EOF
}

clamp_idempotency_key() {
  local key="$1"
  if [[ ${#key} -gt $IDEMPOTENCY_KEY_MAX ]]; then
    echo "Warning: idempotency key length ${#key} > ${IDEMPOTENCY_KEY_MAX}; truncating." >&2
    key="${key:0:$IDEMPOTENCY_KEY_MAX}"
  fi
  printf '%s' "$key"
}

make_idempotency_key() {
  # Keep well under 50 chars: lp-<kind0>-<epoch>-<pid>-<rand>
  local k="${KIND:0:1}"
  local key="lp-${k}-$(date +%s)-$$-${RANDOM}"
  clamp_idempotency_key "$key"
}

# ---------------------------------------------------------------------------
# init
# ---------------------------------------------------------------------------

cmd_init() {
  local chat_id=""
  local as_identity="bot"
  local footer="via lark-push"
  local force=0
  local target="durable" # durable | global | local

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --chat-id)
        require_val "$1" "${2-}"
        chat_id="$2"
        shift 2
        ;;
      --as)
        require_val "$1" "${2-}"
        as_identity="$2"
        shift 2
        ;;
      --footer)
        require_val "$1" "${2-}"
        footer="$2"
        shift 2
        ;;
      --force)
        force=1
        shift
        ;;
      --target)
        require_val "$1" "${2-}"
        target="$2"
        shift 2
        ;;
      -h|--help)
        cat <<'EOF'
Usage:
  lark-push init [options]

Create a local config file next to this skill install (recommended after
`npx skills add`).

Options:
  --chat-id <oc_xxx>     Target Feishu/Lark chat id (required unless already set)
  --as <bot|user>        Default: bot
  --footer <text>        Card footer caption (may start with '-')
  --target <where>       durable | global | local
                           durable (default): <skills-parent>/.skill-data/lark-push/config.env
                           global:            ~/.agents/skills/.skill-data/lark-push/config.env
                           local:             <skill-root>/config.local.env  (wiped by skills update)
  --force                Overwrite existing file
EOF
        return 0
        ;;
      *)
        echo "Unknown init option: $1" >&2
        return 2
        ;;
    esac
  done

  case "$as_identity" in
    bot|user) ;;
    *)
      echo "Invalid --as: $as_identity" >&2
      return 2
      ;;
  esac

  local out_file
  case "$target" in
    durable) out_file="$DURABLE_CONFIG_FILE" ;;
    global) out_file="$GLOBAL_SHARED_CONFIG_FILE" ;;
    local) out_file="$LOCAL_CONFIG_FILE" ;;
    *)
      echo "Invalid --target: $target (use durable|global|local)" >&2
      return 2
      ;;
  esac

  if [[ -z "$chat_id" ]]; then
    if [[ -t 0 ]]; then
      printf "Feishu/Lark chat id (oc_xxx): "
      read -r chat_id
    fi
  fi

  if [[ -z "$chat_id" ]]; then
    echo "Missing chat id. Pass --chat-id oc_xxx" >&2
    return 2
  fi

  if [[ -f "$out_file" && "$force" -ne 1 ]]; then
    echo "Config already exists: $out_file" >&2
    echo "Re-run with --force to overwrite, or edit the file directly." >&2
    return 1
  fi

  mkdir -p "$(dirname -- "$out_file")"

  cat >"$out_file" <<EOF
# Generated by: lark-push init
# Skill root: ${SKILL_ROOT}
# Target: ${target}
#
# Load order (later overrides earlier):
#   1) ~/.config/lark-push/config.env
#   2) ~/.agents/skills/.skill-data/lark-push/config.env
#   3) <skills-parent>/.skill-data/lark-push/config.env
#   4) <skill-root>/config.local.env
#   5) \$LARK_PUSH_CONFIG
#   6) CLI flags (--chat-id, --as, ...)

LARK_PUSH_CHAT_ID=$(printf '%q' "$chat_id")
LARK_PUSH_AS=$(printf '%q' "$as_identity")
LARK_PUSH_FOOTER=$(printf '%q' "$footer")
EOF

  chmod 600 "$out_file" 2>/dev/null || true
  echo "Wrote ${out_file}"
  if [[ "$target" == "local" ]]; then
    echo "Note: local config is inside the skill package and will be wiped by \`npx skills update\`."
  else
    echo "This path is outside the skill package, so it survives \`npx skills update\`."
  fi
}

# ---------------------------------------------------------------------------
# Subcommands
# ---------------------------------------------------------------------------

if [[ "${1:-}" == "init" ]]; then
  shift
  cmd_init "$@"
  exit $?
fi

if [[ "${1:-}" == "config-path" || "${1:-}" == "paths" ]]; then
  print_config_paths
  exit 0
fi

if [[ "${1:-}" == "which-config" ]]; then
  load_all_configs
  print_config_paths
  echo
  echo "Effective:"
  echo "  LARK_PUSH_CHAT_ID=${LARK_PUSH_CHAT_ID:-"(unset)"}"
  echo "  LARK_PUSH_AS=${LARK_PUSH_AS:-bot}"
  echo "  LARK_PUSH_FOOTER=${LARK_PUSH_FOOTER:-via lark-push}"
  exit 0
fi

if [[ "${1:-}" == "version" || "${1:-}" == "--version" ]]; then
  echo "lark-push v$(skill_version)"
  exit 0
fi

load_all_configs

CHAT_ID="${LARK_PUSH_CHAT_ID:-}"
AS_IDENTITY="${LARK_PUSH_AS:-bot}"
FOOTER="${LARK_PUSH_FOOTER:-via lark-push}"
KIND="notice"
TITLE=""
BODY=""
BODY_FILE=""
FORMAT="card"
DRY_RUN=0
INCLUDE_CONTEXT=1
IDEMPOTENCY_KEY=""

usage() {
  cat <<EOF
Usage:
  lark-push [options]
  lark-push init [init-options]
  lark-push config-path
  lark-push which-config
  lark-push version

Send Options:
  --kind <code|daily|weekly|release|notice>
  --format <card|markdown>     Default: card
  --title <text>
  --body <text>                May start with '-' (markdown lists OK)
  --from-file <path>
  --chat-id <oc_xxx>           Override config / env
  --as <bot|user>              Default: bot
  --idempotency-key <key>      Max ${IDEMPOTENCY_KEY_MAX} chars (lark-cli limit)
  --dry-run                    Local preview only (no lark-cli / no keychain)
  --no-context                 Do not add repo/branch context
  --version                    Print version
  -h, --help

Config (follows skill install location):
  Preferred durable file (survives skills update):
    <skills-parent>/.skill-data/lark-push/config.env

  After install:
    bash scripts/lark-push init --chat-id oc_xxx

  Inspect:
    bash scripts/lark-push config-path
    bash scripts/lark-push which-config

Examples:
  lark-push --dry-run --kind code --title "Code task complete" --body "Tests passed."
  lark-push --dry-run --kind daily --title "Daily" --body "- shipped A
- blocked on B"
  cat daily.md | lark-push --kind daily --title "Daily report"
  lark-push init --chat-id oc_xxx --footer "via my bot"
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --kind)
      require_val "$1" "${2-}"
      KIND="$2"
      shift 2
      ;;
    --format)
      require_val "$1" "${2-}"
      FORMAT="$2"
      shift 2
      ;;
    --title)
      require_val "$1" "${2-}"
      TITLE="$2"
      shift 2
      ;;
    --body)
      require_val "$1" "${2-}"
      BODY="$2"
      shift 2
      ;;
    --from-file)
      require_val "$1" "${2-}"
      BODY_FILE="$2"
      shift 2
      ;;
    --chat-id)
      require_val "$1" "${2-}"
      CHAT_ID="$2"
      shift 2
      ;;
    --as)
      require_val "$1" "${2-}"
      AS_IDENTITY="$2"
      shift 2
      ;;
    --idempotency-key)
      require_val "$1" "${2-}"
      IDEMPOTENCY_KEY="$2"
      shift 2
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    --no-context)
      INCLUDE_CONTEXT=0
      shift
      ;;
    --version)
      echo "lark-push v$(skill_version)"
      exit 0
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

case "$KIND" in
  code|daily|weekly|release|notice) ;;
  *)
    echo "Invalid --kind: $KIND" >&2
    exit 2
    ;;
esac

case "$FORMAT" in
  card|markdown) ;;
  *)
    echo "Invalid --format: $FORMAT" >&2
    exit 2
    ;;
esac

case "$AS_IDENTITY" in
  bot|user) ;;
  *)
    echo "Invalid --as: $AS_IDENTITY (use bot|user)" >&2
    exit 2
    ;;
esac

if [[ -z "$CHAT_ID" ]]; then
  echo "Missing chat id." >&2
  echo "Run once after install:" >&2
  echo "  bash ${SCRIPT_DIR}/lark-push init --chat-id oc_xxx" >&2
  echo "Or pass --chat-id / set LARK_PUSH_CHAT_ID." >&2
  echo >&2
  print_config_paths >&2
  exit 2
fi

if [[ -n "$BODY_FILE" ]]; then
  if [[ ! -f "$BODY_FILE" ]]; then
    echo "Body file does not exist: $BODY_FILE" >&2
    exit 2
  fi
  BODY="$(<"$BODY_FILE")"
elif [[ -z "$BODY" && ! -t 0 ]]; then
  BODY="$(cat)"
fi

if [[ -z "$TITLE" ]]; then
  case "$KIND" in
    code) TITLE="Code update" ;;
    daily) TITLE="Daily report" ;;
    weekly) TITLE="Weekly report" ;;
    release) TITLE="Release notice" ;;
    notice) TITLE="Notice" ;;
  esac
fi

if [[ -z "$BODY" ]]; then
  echo "Message body is empty. Use --body, --from-file, or stdin." >&2
  exit 2
fi

case "$KIND" in
  code) ICON="💻"; LABEL="Code" ;;
  daily) ICON="🗓️"; LABEL="Daily" ;;
  weekly) ICON="📊"; LABEL="Weekly" ;;
  release) ICON="🚀"; LABEL="Release" ;;
  notice) ICON="🔔"; LABEL="Notice" ;;
esac

NOW="$(date '+%Y-%m-%d %H:%M:%S %Z')"
CONTEXT=""
SOURCE_TEXT=""

if [[ "$INCLUDE_CONTEXT" -eq 1 ]]; then
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
    REPO_NAME="$(basename "$REPO_ROOT")"
    BRANCH="$(git branch --show-current 2>/dev/null || true)"
    SHA="$(git rev-parse --short HEAD 2>/dev/null || true)"
    SOURCE_TEXT="${REPO_NAME}${BRANCH:+ / ${BRANCH}}${SHA:+ @ ${SHA}}"
    CONTEXT=$'\n'"**Source**: ${SOURCE_TEXT}"
  else
    SOURCE_TEXT="$(basename "$PWD")"
    CONTEXT=$'\n'"**Source**: ${SOURCE_TEXT}"
  fi
fi

MESSAGE=""
if [[ "$FORMAT" == "markdown" ]]; then
  MESSAGE="#### ${ICON} ${TITLE}

**Type**: ${LABEL}
**Time**: ${NOW}${CONTEXT}

${BODY}"
fi

if [[ -z "$IDEMPOTENCY_KEY" ]]; then
  IDEMPOTENCY_KEY="$(make_idempotency_key)"
else
  IDEMPOTENCY_KEY="$(clamp_idempotency_key "$IDEMPOTENCY_KEY")"
fi

CARD_JSON=""
if [[ "$FORMAT" == "card" ]]; then
  if ! command -v python3 >/dev/null 2>&1; then
    echo "python3 is required to build Card 2.0 JSON." >&2
    exit 127
  fi
  if [[ ! -f "$SKILL_ROOT/scripts/build_card.py" ]]; then
    echo "Missing card builder: $SKILL_ROOT/scripts/build_card.py" >&2
    exit 127
  fi

  CARD_JSON="$(
    CARD_KIND="$KIND" \
    CARD_TITLE="$TITLE" \
    CARD_LABEL="$LABEL" \
    CARD_NOW="$NOW" \
    CARD_SOURCE="$SOURCE_TEXT" \
    CARD_BODY="$BODY" \
    CARD_FOOTER="$FOOTER" \
    python3 "$SKILL_ROOT/scripts/build_card.py"
  )"
fi

payload_bytes=0
if [[ "$FORMAT" == "card" ]]; then
  payload_bytes=${#CARD_JSON}
else
  payload_bytes=${#MESSAGE}
fi
if (( payload_bytes > PAYLOAD_WARN_BYTES )); then
  echo "Warning: payload is ${payload_bytes} bytes; very large messages may fail OS ARG_MAX limits when calling lark-cli." >&2
fi

# Local dry-run: never touch lark-cli / keychain / network.
if [[ "$DRY_RUN" -eq 1 ]]; then
  cat <<EOF >&2
[dry-run] lark-push v$(skill_version)
[dry-run] kind=${KIND} format=${FORMAT} as=${AS_IDENTITY}
[dry-run] chat_id=${CHAT_ID}
[dry-run] title=${TITLE}
[dry-run] idempotency_key=${IDEMPOTENCY_KEY} (len=${#IDEMPOTENCY_KEY})
[dry-run] payload_bytes=${payload_bytes}
[dry-run] not calling lark-cli
EOF
  if [[ "$FORMAT" == "card" ]]; then
    printf '%s\n' "$CARD_JSON"
  else
    printf '%s\n' "$MESSAGE"
  fi
  exit 0
fi

if ! command -v lark-cli >/dev/null 2>&1; then
  echo "lark-cli not found in PATH. Install and authenticate first." >&2
  exit 127
fi

if [[ "$FORMAT" == "card" ]]; then
  CMD=(lark-cli im +messages-send --as "$AS_IDENTITY" --chat-id "$CHAT_ID" --msg-type interactive --content "$CARD_JSON" --idempotency-key "$IDEMPOTENCY_KEY" --json)
else
  CMD=(lark-cli im +messages-send --as "$AS_IDENTITY" --chat-id "$CHAT_ID" --markdown "$MESSAGE" --idempotency-key "$IDEMPOTENCY_KEY" --json)
fi

# silence unused (template may be referenced by docs/tools)
: "${EXAMPLE_CONFIG_FILE}"

LARKSUITE_CLI_NO_UPDATE_NOTIFIER=1 LARKSUITE_CLI_NO_SKILLS_NOTIFIER=1 "${CMD[@]}"
