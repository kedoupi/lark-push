#!/usr/bin/env bash
set -euo pipefail

# Resolve skill root even when this script is reached via agent symlink.
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
SKILL_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd -P)"
SKILL_NAME="$(basename -- "$SKILL_ROOT")"
SKILLS_PARENT="$(dirname -- "$SKILL_ROOT")"

# Recommended brand+XDG config (default for init)
KEDOUPI_CONFIG_DIR="${HOME}/.config/kedoupi/${SKILL_NAME}"
KEDOUPI_CONFIG_FILE="${KEDOUPI_CONFIG_DIR}/config.env"

# Legacy: install-adjacent durable (still read; may migrate once)
# skills CLI reinstall/update wipes the skill directory itself, but keeps siblings.
DURABLE_CONFIG_DIR="${SKILLS_PARENT}/.skill-data/${SKILL_NAME}"
DURABLE_CONFIG_FILE="${DURABLE_CONFIG_DIR}/config.env"

# Shared fallback (useful when install mode is copy and agents each have a private tree)
GLOBAL_SHARED_CONFIG_FILE="${HOME}/.agents/skills/.skill-data/${SKILL_NAME}/config.env"

# Optional in-package override (convenient, but wiped by `npx skills update`)
LOCAL_CONFIG_FILE="${SKILL_ROOT}/config.local.env"

# Legacy XDG path (still supported)
XDG_CONFIG_FILE="${HOME}/.config/lark-push/config.env"

EXAMPLE_CONFIG_FILE="${SKILL_ROOT}/config.example.env"
SKILL_MD_FILE="${SKILL_ROOT}/SKILL.md"

# lark-cli hard limit
IDEMPOTENCY_KEY_MAX=50
# Soft warn when card/body payload may approach OS ARG_MAX
PAYLOAD_WARN_BYTES=100000

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

# Require a non-empty option value. Values may start with "-" (markdown lists).
# Usage: require_val --opt "${2-}" && val="$2"
require_val() {
  local opt="$1"
  if [[ $# -lt 2 ]]; then
    echo "Missing value for $opt" >&2
    exit 2
  fi
  local val="$2"
  if [[ -z "$val" ]]; then
    echo "Empty value for $opt" >&2
    exit 2
  fi
}

skill_version() {
  local v=""
  if [[ -f "$SKILL_MD_FILE" ]]; then
    v="$(sed -nE 's/^[[:space:]]*version:[[:space:]]*"([^"]+)".*/\1/p' "$SKILL_MD_FILE" | head -n1)"
  fi
  if [[ -z "$v" ]]; then
    v="0.0.0"
  fi
  printf '%s' "$v"
}

load_env_file() {
  local file="$1"
  [[ -f "$file" ]] || return 0
  local was_a=0
  [[ $- == *a* ]] && was_a=1
  set -a
  # shellcheck disable=SC1090
  source "$file"
  if (( ! was_a )); then
    set +a
  fi
}

# If recommended kedoupi config is missing, copy once from a legacy config file.
ensure_kedoupi_config() {
  if [[ -f "$KEDOUPI_CONFIG_FILE" ]]; then
    return 0
  fi
  local src
  for src in "$DURABLE_CONFIG_FILE" "$GLOBAL_SHARED_CONFIG_FILE" "$XDG_CONFIG_FILE"; do
    if [[ -f "$src" && -s "$src" ]]; then
      mkdir -p "$KEDOUPI_CONFIG_DIR"
      cp "$src" "$KEDOUPI_CONFIG_FILE"
      chmod 600 "$KEDOUPI_CONFIG_FILE" 2>/dev/null || true
      echo "lark-push: migrated config → ${KEDOUPI_CONFIG_FILE}" >&2
      echo "  (from ${src})" >&2
      return 0
    fi
  done
}

# Least-specific → most-specific. Later files override earlier ones.
load_all_configs() {
  ensure_kedoupi_config
  load_env_file "$XDG_CONFIG_FILE"
  load_env_file "$GLOBAL_SHARED_CONFIG_FILE"
  if [[ "$DURABLE_CONFIG_FILE" != "$GLOBAL_SHARED_CONFIG_FILE" ]]; then
    load_env_file "$DURABLE_CONFIG_FILE"
  fi
  load_env_file "$KEDOUPI_CONFIG_FILE"
  load_env_file "$LOCAL_CONFIG_FILE"
  if [[ -n "${LARK_PUSH_CONFIG:-}" ]]; then
    load_env_file "$LARK_PUSH_CONFIG"
  fi
}

print_config_paths() {
  cat <<EOF
Skill root:           ${SKILL_ROOT}
Version:              $(skill_version)
Kedoupi config:       ${KEDOUPI_CONFIG_FILE}$([[ -f "$KEDOUPI_CONFIG_FILE" ]] && echo "  [exists · recommended]" || echo "  [missing · run: lark-push init]")
Legacy durable:       ${DURABLE_CONFIG_FILE}$([[ -f "$DURABLE_CONFIG_FILE" ]] && echo "  [exists]" || echo "  [missing]")
Global shared:        ${GLOBAL_SHARED_CONFIG_FILE}$([[ -f "$GLOBAL_SHARED_CONFIG_FILE" ]] && echo "  [exists]" || echo "  [missing]")
Local (in skill):     ${LOCAL_CONFIG_FILE}$([[ -f "$LOCAL_CONFIG_FILE" ]] && echo "  [exists · wiped on skills update]" || echo "  [missing]")
XDG legacy:           ${XDG_CONFIG_FILE}$([[ -f "$XDG_CONFIG_FILE" ]] && echo "  [exists]" || echo "  [missing]")
Explicit override:    ${LARK_PUSH_CONFIG:-"(unset)"}
EOF
}

clamp_idempotency_key() {
  local key="$1"
  if [[ ${#key} -gt $IDEMPOTENCY_KEY_MAX ]]; then
    echo "Warning: idempotency key length ${#key} > ${IDEMPOTENCY_KEY_MAX}; truncating." >&2
    key="${key:0:$IDEMPOTENCY_KEY_MAX}"
  fi
  printf '%s' "$key"
}

make_idempotency_key() {
  # Keep well under 50 chars: lp-<kind0>-<epoch>-<pid>-<rand>
  local k="${KIND:0:1}"
  local key="lp-${k}-$(date +%s)-$$-${RANDOM}"
  clamp_idempotency_key "$key"
}

# ---------------------------------------------------------------------------
# Dependency / install guidance
# ---------------------------------------------------------------------------

print_install_node() {
  cat <<'EOF' >&2
Node.js / npm is missing (needed for: npx skills add, and usually for installing lark-cli).

Install Node.js LTS, then re-open your terminal:

  # macOS (Homebrew)
  brew install node

  # Or official installer:
  #   https://nodejs.org/

Verify:
  node -v
  npm -v
  command -v npx
EOF
}

print_install_lark_cli() {
  cat <<'EOF' >&2
lark-cli is missing from PATH (required to send Feishu / Lark messages).

1) If you do not have Node.js / npm yet, install Node LTS first:
     https://nodejs.org/
     # macOS: brew install node

2) Install the official CLI:
     npm install -g @larksuite/cli

3) Configure & auth (use a real interactive Terminal.app on macOS if keychain fails):
     lark-cli config init --help
     lark-cli auth status --json --verify
     # User identity (optional for bot-only sends):
     #   lark-cli auth login --domain im --json
     # Agent / sandbox on macOS after interactive setup:
     #   lark-cli config keychain-downgrade

Docs: https://github.com/larksuite/cli
EOF
}

print_install_python3() {
  cat <<'EOF' >&2
python3 is missing (required for default --format card Card 2.0 JSON).

Install python3, or send with plain markdown instead:

  # macOS
  brew install python3

  # Or use markdown format (no python3):
  bash scripts/lark-push --format markdown --kind notice --title "..." --body "..."
EOF
}

require_lark_cli() {
  if command -v lark-cli >/dev/null 2>&1; then
    return 0
  fi
  echo "Error: lark-cli not found in PATH." >&2
  echo >&2
  print_install_lark_cli
  echo >&2
  echo "Tip: run  bash ${SCRIPT_DIR}/lark-push doctor  for a full checklist." >&2
  exit 127
}

require_python3_for_card() {
  if command -v python3 >/dev/null 2>&1; then
    return 0
  fi
  echo "Error: python3 is required to build Card 2.0 JSON." >&2
  echo >&2
  print_install_python3
  echo >&2
  echo "Tip: run  bash ${SCRIPT_DIR}/lark-push doctor  for a full checklist." >&2
  exit 127
}

# doctor: offline-friendly checks. Auth verify is soft (may fail in sandboxes).
cmd_doctor() {
  local strict_auth=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --strict-auth) strict_auth=1; shift ;;
      -h|--help)
        cat <<'EOF'
Usage: lark-push doctor [--strict-auth]

Check environment for sending with this skill:
  - Node.js / npm / npx  (install skill via npx; install lark-cli via npm)
  - lark-cli             (required to send)
  - python3              (required for default card format)
  - durable config       (chat id)
  - optional auth probe  (soft unless --strict-auth)

Exit 0 if required items pass; exit 1 if any required check fails.
EOF
        return 0
        ;;
      *)
        echo "Unknown doctor option: $1" >&2
        return 2
        ;;
    esac
  done

  local fail=0
  local warn=0
  local ok=0

  pass() { echo "  [ok]   $1"; ok=$((ok + 1)); }
  soft() { echo "  [warn] $1"; warn=$((warn + 1)); }
  hard() { echo "  [FAIL] $1"; fail=$((fail + 1)); }

  echo "lark-push doctor  v$(skill_version)"
  echo "Skill root: ${SKILL_ROOT}"
  echo

  echo "== Toolchain (install skill / CLI) =="
  if command -v node >/dev/null 2>&1; then
    pass "node  $(node -v 2>/dev/null | tr -d '\n')"
  else
    soft "node not found — needed for npx skills add and typical lark-cli install"
  fi
  if command -v npm >/dev/null 2>&1; then
    pass "npm   $(npm -v 2>/dev/null | tr -d '\n')"
  else
    soft "npm not found — install Node.js LTS from https://nodejs.org/ or: brew install node"
  fi
  if command -v npx >/dev/null 2>&1; then
    pass "npx   available"
  else
    soft "npx not found — cannot run: npx skills add kedoupi/lark-push"
  fi
  if ! command -v node >/dev/null 2>&1 || ! command -v npm >/dev/null 2>&1; then
    echo
    print_install_node
  fi

  echo
  echo "== Runtime (send messages) =="
  if command -v lark-cli >/dev/null 2>&1; then
    local lc_ver
    lc_ver="$(lark-cli --version 2>/dev/null | head -n1 || true)"
    pass "lark-cli  ${lc_ver:-found}"
  else
    hard "lark-cli not found in PATH (required to send)"
    echo
    print_install_lark_cli
  fi

  if command -v python3 >/dev/null 2>&1; then
    pass "python3  $(python3 --version 2>/dev/null | tr -d '\n')"
  else
    hard "python3 not found (required for default --format card)"
    echo
    print_install_python3
  fi

  if [[ -f "$SKILL_ROOT/scripts/build_card.py" ]]; then
    pass "build_card.py present"
  else
    hard "missing $SKILL_ROOT/scripts/build_card.py (reinstall skill)"
  fi

  echo
  echo "== Config =="
  load_all_configs
  print_config_paths
  if [[ -n "${LARK_PUSH_CHAT_ID:-}" ]]; then
    pass "LARK_PUSH_CHAT_ID is set"
  else
    hard "LARK_PUSH_CHAT_ID unset — run: bash ${SCRIPT_DIR}/lark-push init --chat-id oc_xxx"
  fi

  echo
  echo "== Auth (optional probe) =="
  if ! command -v lark-cli >/dev/null 2>&1; then
    soft "skip auth — install lark-cli first"
  else
    local auth_out auth_code
    set +e
    auth_out="$(LARKSUITE_CLI_NO_UPDATE_NOTIFIER=1 LARKSUITE_CLI_NO_SKILLS_NOTIFIER=1 \
      lark-cli auth status --json --verify 2>&1)"
    auth_code=$?
    set -e
    if [[ "$auth_code" -eq 0 ]] && [[ "$auth_out" == *'"verified": true'* || "$auth_out" == *'"verified":true'* || "$auth_out" == *'"status": "ready"'* || "$auth_out" == *'"status":"ready"'* ]]; then
      pass "lark-cli auth status --verify looks healthy"
    elif [[ "$auth_out" == *'keychain'* ]]; then
      soft "lark-cli auth blocked on keychain (common in Agent sandboxes)"
      echo "         Fix in interactive Terminal.app:" >&2
      echo "           lark-cli config keychain-downgrade" >&2
      echo "           lark-cli auth status --json --verify" >&2
      if [[ "$strict_auth" -eq 1 ]]; then
        hard "strict-auth: keychain/auth not usable in this environment"
      fi
    else
      soft "lark-cli auth not ready (exit ${auth_code})"
      echo "         Run: lark-cli config init --help" >&2
      echo "              lark-cli auth status --json --verify" >&2
      if [[ "$strict_auth" -eq 1 ]]; then
        hard "strict-auth: auth probe failed"
      fi
    fi
  fi

  echo
  echo "Summary: ${ok} ok, ${warn} warn, ${fail} fail"
  if [[ "$fail" -gt 0 ]]; then
    echo "Required checks failed. Fix [FAIL] items above, then re-run doctor."
    print_setup_hints
    return 1
  fi
  echo "Required checks passed. You can send with lark-push (bot identity is typical)."
  print_setup_hints
  return 0
}

print_setup_hints() {
  load_all_configs
  if [[ -n "${LARK_PUSH_CHAT_ID:-}" && -f "$KEDOUPI_CONFIG_FILE" ]]; then
    return 0
  fi
  cat <<EOF

== After install / missing chat config ==
Copy-paste (edit oc_… then run). Writes ~/.config/kedoupi/lark-push/config.env:

  bash ${SCRIPT_DIR}/lark-push init --chat-id 'oc_YOUR_CHAT_ID'

Also need Feishu CLI auth (once per machine):

  npm install -g @larksuite/cli
  lark-cli config init --help
  LARKSUITE_CLI_NO_UPDATE_NOTIFIER=1 LARKSUITE_CLI_NO_SKILLS_NOTIFIER=1 \\
    lark-cli auth status --json --verify

Then:  bash ${SCRIPT_DIR}/lark-push doctor
EOF
}

# ---------------------------------------------------------------------------
# init
# ---------------------------------------------------------------------------

cmd_init() {
  local chat_id=""
  local as_identity="bot"
  local footer="via lark-push"
  local force=0
  local target="kedoupi" # kedoupi | durable | global | local

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --chat-id)
        require_val "$1" "${2-}"
        chat_id="$2"
        shift 2
        ;;
      --as)
        require_val "$1" "${2-}"
        as_identity="$2"
        shift 2
        ;;
      --footer)
        require_val "$1" "${2-}"
        footer="$2"
        shift 2
        ;;
      --force)
        force=1
        shift
        ;;
      --target)
        require_val "$1" "${2-}"
        target="$2"
        shift 2
        ;;
      -h|--help)
        cat <<'EOF'
Usage:
  lark-push init [options]

Write Feishu/Lark push config (survives npx skills update).

Default path (recommended):
  ~/.config/kedoupi/lark-push/config.env

Options:
  --chat-id <oc_xxx>     Target Feishu/Lark chat id (required unless already set)
  --as <bot|user>        Default: bot
  --footer <text>        Card footer caption (may start with '-')
  --target <where>       kedoupi | durable | global | local
                           kedoupi (default): ~/.config/kedoupi/lark-push/config.env
                           durable:           <skills-parent>/.skill-data/lark-push/config.env
                           global:            ~/.agents/skills/.skill-data/lark-push/config.env
                           local:             <skill-root>/config.local.env  (wiped by skills update)
  --force                Overwrite existing file
EOF
        return 0
        ;;
      *)
        echo "Unknown init option: $1" >&2
        return 2
        ;;
    esac
  done

  case "$as_identity" in
    bot|user) ;;
    *)
      echo "Invalid --as: $as_identity" >&2
      return 2
      ;;
  esac

  local out_file
  case "$target" in
    kedoupi|default) out_file="$KEDOUPI_CONFIG_FILE" ;;
    durable) out_file="$DURABLE_CONFIG_FILE" ;;
    global) out_file="$GLOBAL_SHARED_CONFIG_FILE" ;;
    local) out_file="$LOCAL_CONFIG_FILE" ;;
    *)
      echo "Invalid --target: $target (use kedoupi|durable|global|local)" >&2
      return 2
      ;;
  esac

  if [[ -z "$chat_id" ]]; then
    if [[ -t 0 ]]; then
      printf "Feishu/Lark chat id (oc_xxx): "
      read -r chat_id
    fi
  fi

  if [[ -z "$chat_id" ]]; then
    echo "Missing chat id. Pass --chat-id oc_xxx" >&2
    return 2
  fi

  if [[ -f "$out_file" && "$force" -ne 1 ]]; then
    echo "Config already exists: $out_file" >&2
    echo "Re-run with --force to overwrite, or edit the file directly." >&2
    return 1
  fi

  mkdir -p "$(dirname -- "$out_file")"

  cat >"$out_file" <<EOF
# Generated by: lark-push init
# Skill root: ${SKILL_ROOT}
# Target: ${target}
#
# Load order (later overrides earlier):
#   1) ~/.config/lark-push/config.env
#   2) ~/.agents/skills/.skill-data/lark-push/config.env
#   3) <skills-parent>/.skill-data/lark-push/config.env
#   4) ~/.config/kedoupi/lark-push/config.env   (recommended)
#   5) <skill-root>/config.local.env
#   6) \$LARK_PUSH_CONFIG
#   6) CLI flags (--chat-id, --as, ...)

LARK_PUSH_CHAT_ID=$(printf '%q' "$chat_id")
LARK_PUSH_AS=$(printf '%q' "$as_identity")
LARK_PUSH_FOOTER=$(printf '%q' "$footer")
EOF

  chmod 600 "$out_file" 2>/dev/null || true
  echo "Wrote ${out_file}"
  if [[ "$target" == "local" ]]; then
    echo "Note: local config is inside the skill package and will be wiped by \`npx skills update\`."
  else
    echo "This path is outside the skill package, so it survives \`npx skills update\`."
  fi
}

# ---------------------------------------------------------------------------
# Subcommands
# ---------------------------------------------------------------------------

if [[ "${1:-}" == "init" ]]; then
  shift
  cmd_init "$@"
  exit $?
fi

if [[ "${1:-}" == "doctor" ]]; then
  shift
  cmd_doctor "$@"
  exit $?
fi

if [[ "${1:-}" == "config-path" || "${1:-}" == "paths" ]]; then
  print_config_paths
  exit 0
fi

if [[ "${1:-}" == "which-config" ]]; then
  load_all_configs
  print_config_paths
  echo
  echo "Effective:"
  echo "  LARK_PUSH_CHAT_ID=${LARK_PUSH_CHAT_ID:-"(unset)"}"
  echo "  LARK_PUSH_AS=${LARK_PUSH_AS:-bot}"
  echo "  LARK_PUSH_FOOTER=${LARK_PUSH_FOOTER:-via lark-push}"
  exit 0
fi

if [[ "${1:-}" == "version" || "${1:-}" == "--version" ]]; then
  echo "lark-push v$(skill_version)"
  exit 0
fi

load_all_configs

CHAT_ID="${LARK_PUSH_CHAT_ID:-}"
AS_IDENTITY="${LARK_PUSH_AS:-bot}"
FOOTER="${LARK_PUSH_FOOTER:-via lark-push}"
KIND="notice"
TITLE=""
BODY=""
BODY_FILE=""
FORMAT="card"
DRY_RUN=0
INCLUDE_CONTEXT=1
IDEMPOTENCY_KEY=""

usage() {
  cat <<EOF
Usage:
  lark-push [options]
  lark-push init [init-options]
  lark-push doctor [--strict-auth]
  lark-push config-path
  lark-push which-config
  lark-push version

Send Options:
  --kind <code|daily|weekly|release|notice>
  --format <card|markdown>     Default: card
  --title <text>
  --body <text>                May start with '-' (markdown lists OK)
  --from-file <path>
  --chat-id <oc_xxx>           Override config / env
  --as <bot|user>              Default: bot
  --idempotency-key <key>      Max ${IDEMPOTENCY_KEY_MAX} chars (lark-cli limit)
  --dry-run                    Local preview only (no lark-cli / no keychain)
  --no-context                 Do not add repo/branch context
  --version                    Print version
  -h, --help

Setup (first time):
  1) Node.js LTS (for npx / npm):  https://nodejs.org/   or  brew install node
  2) Install this skill:           npx skills add kedoupi/lark-push -g --all
  3) Install Feishu CLI:           npm install -g @larksuite/cli
  4) Configure CLI + auth:         lark-cli config init / auth status
  5) Skill config:                 bash scripts/lark-push init --chat-id oc_xxx
  6) Check everything:             bash scripts/lark-push doctor

Config (follows skill install location):
  Preferred durable file (survives skills update):
    <skills-parent>/.skill-data/lark-push/config.env

Examples:
  lark-push doctor
  lark-push --dry-run --kind code --title "Code task complete" --body "Tests passed."
  lark-push --dry-run --kind daily --title "Daily" --body "- shipped A
- blocked on B"
  cat daily.md | lark-push --kind daily --title "Daily report"
  lark-push init --chat-id oc_xxx --footer "via my bot"
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --kind)
      require_val "$1" "${2-}"
      KIND="$2"
      shift 2
      ;;
    --format)
      require_val "$1" "${2-}"
      FORMAT="$2"
      shift 2
      ;;
    --title)
      require_val "$1" "${2-}"
      TITLE="$2"
      shift 2
      ;;
    --body)
      require_val "$1" "${2-}"
      BODY="$2"
      shift 2
      ;;
    --from-file)
      require_val "$1" "${2-}"
      BODY_FILE="$2"
      shift 2
      ;;
    --chat-id)
      require_val "$1" "${2-}"
      CHAT_ID="$2"
      shift 2
      ;;
    --as)
      require_val "$1" "${2-}"
      AS_IDENTITY="$2"
      shift 2
      ;;
    --idempotency-key)
      require_val "$1" "${2-}"
      IDEMPOTENCY_KEY="$2"
      shift 2
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    --no-context)
      INCLUDE_CONTEXT=0
      shift
      ;;
    --version)
      echo "lark-push v$(skill_version)"
      exit 0
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

case "$KIND" in
  code|daily|weekly|release|notice) ;;
  *)
    echo "Invalid --kind: $KIND" >&2
    exit 2
    ;;
esac

case "$FORMAT" in
  card|markdown) ;;
  *)
    echo "Invalid --format: $FORMAT" >&2
    exit 2
    ;;
esac

case "$AS_IDENTITY" in
  bot|user) ;;
  *)
    echo "Invalid --as: $AS_IDENTITY (use bot|user)" >&2
    exit 2
    ;;
esac

if [[ -z "$CHAT_ID" ]]; then
  echo "Missing chat id." >&2
  echo "Run once after install:" >&2
  echo "  bash ${SCRIPT_DIR}/lark-push init --chat-id oc_xxx" >&2
  echo "Or pass --chat-id / set LARK_PUSH_CHAT_ID." >&2
  echo >&2
  print_config_paths >&2
  exit 2
fi

if [[ -n "$BODY_FILE" ]]; then
  if [[ ! -f "$BODY_FILE" ]]; then
    echo "Body file does not exist: $BODY_FILE" >&2
    exit 2
  fi
  BODY="$(<"$BODY_FILE")"
elif [[ -z "$BODY" && ! -t 0 ]]; then
  BODY="$(cat)"
fi

if [[ -z "$TITLE" ]]; then
  case "$KIND" in
    code) TITLE="Code update" ;;
    daily) TITLE="Daily report" ;;
    weekly) TITLE="Weekly report" ;;
    release) TITLE="Release notice" ;;
    notice) TITLE="Notice" ;;
  esac
fi

if [[ -z "$BODY" ]]; then
  echo "Message body is empty. Use --body, --from-file, or stdin." >&2
  exit 2
fi

case "$KIND" in
  code) ICON="💻"; LABEL="Code" ;;
  daily) ICON="🗓️"; LABEL="Daily" ;;
  weekly) ICON="📊"; LABEL="Weekly" ;;
  release) ICON="🚀"; LABEL="Release" ;;
  notice) ICON="🔔"; LABEL="Notice" ;;
esac

NOW="$(date '+%Y-%m-%d %H:%M:%S %Z')"
CONTEXT=""
SOURCE_TEXT=""

if [[ "$INCLUDE_CONTEXT" -eq 1 ]]; then
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
    REPO_NAME="$(basename "$REPO_ROOT")"
    BRANCH="$(git branch --show-current 2>/dev/null || true)"
    SHA="$(git rev-parse --short HEAD 2>/dev/null || true)"
    SOURCE_TEXT="${REPO_NAME}${BRANCH:+ / ${BRANCH}}${SHA:+ @ ${SHA}}"
    CONTEXT=$'\n'"**Source**: ${SOURCE_TEXT}"
  else
    SOURCE_TEXT="$(basename "$PWD")"
    CONTEXT=$'\n'"**Source**: ${SOURCE_TEXT}"
  fi
fi

MESSAGE=""
if [[ "$FORMAT" == "markdown" ]]; then
  MESSAGE="#### ${ICON} ${TITLE}

**Type**: ${LABEL}
**Time**: ${NOW}${CONTEXT}

${BODY}"
fi

if [[ -z "$IDEMPOTENCY_KEY" ]]; then
  IDEMPOTENCY_KEY="$(make_idempotency_key)"
else
  IDEMPOTENCY_KEY="$(clamp_idempotency_key "$IDEMPOTENCY_KEY")"
fi

CARD_JSON=""
if [[ "$FORMAT" == "card" ]]; then
  require_python3_for_card
  if [[ ! -f "$SKILL_ROOT/scripts/build_card.py" ]]; then
    echo "Missing card builder: $SKILL_ROOT/scripts/build_card.py" >&2
    echo "Reinstall the skill: npx skills add kedoupi/lark-push -g --all" >&2
    exit 127
  fi

  CARD_JSON="$(
    CARD_KIND="$KIND" \
    CARD_TITLE="$TITLE" \
    CARD_LABEL="$LABEL" \
    CARD_NOW="$NOW" \
    CARD_SOURCE="$SOURCE_TEXT" \
    CARD_BODY="$BODY" \
    CARD_FOOTER="$FOOTER" \
    python3 "$SKILL_ROOT/scripts/build_card.py"
  )"
fi

payload_bytes=0
if [[ "$FORMAT" == "card" ]]; then
  payload_bytes=${#CARD_JSON}
else
  payload_bytes=${#MESSAGE}
fi
if (( payload_bytes > PAYLOAD_WARN_BYTES )); then
  echo "Warning: payload is ${payload_bytes} bytes; very large messages may fail OS ARG_MAX limits when calling lark-cli." >&2
fi

# Local dry-run: never touch lark-cli / keychain / network.
if [[ "$DRY_RUN" -eq 1 ]]; then
  cat <<EOF >&2
[dry-run] lark-push v$(skill_version)
[dry-run] kind=${KIND} format=${FORMAT} as=${AS_IDENTITY}
[dry-run] chat_id=${CHAT_ID}
[dry-run] title=${TITLE}
[dry-run] idempotency_key=${IDEMPOTENCY_KEY} (len=${#IDEMPOTENCY_KEY})
[dry-run] payload_bytes=${payload_bytes}
[dry-run] not calling lark-cli
EOF
  if [[ "$FORMAT" == "card" ]]; then
    printf '%s\n' "$CARD_JSON"
  else
    printf '%s\n' "$MESSAGE"
  fi
  exit 0
fi

require_lark_cli

if [[ "$FORMAT" == "card" ]]; then
  CMD=(lark-cli im +messages-send --as "$AS_IDENTITY" --chat-id "$CHAT_ID" --msg-type interactive --content "$CARD_JSON" --idempotency-key "$IDEMPOTENCY_KEY" --json)
else
  CMD=(lark-cli im +messages-send --as "$AS_IDENTITY" --chat-id "$CHAT_ID" --markdown "$MESSAGE" --idempotency-key "$IDEMPOTENCY_KEY" --json)
fi

# silence unused (template may be referenced by docs/tools)
: "${EXAMPLE_CONFIG_FILE}"

LARKSUITE_CLI_NO_UPDATE_NOTIFIER=1 LARKSUITE_CLI_NO_SKILLS_NOTIFIER=1 "${CMD[@]}"
