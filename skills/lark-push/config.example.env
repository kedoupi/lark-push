# Copy via:
#   bash scripts/lark-push init --chat-id oc_xxx
#
# Recommended path (default for init):
#   ~/.config/kedoupi/lark-push/config.env
#
# Legacy paths still loaded (and auto-migrated once into kedoupi):
#   ~/.agents/skills/.skill-data/lark-push/config.env
#   <skills-parent>/.skill-data/lark-push/config.env

LARK_PUSH_CHAT_ID='oc_xxxxxxxx'
LARK_PUSH_AS='bot'
LARK_PUSH_FOOTER='via lark-push'
